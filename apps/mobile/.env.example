# Public Supabase project (read-only through RLS). Copy this file to .env and fill in the anon key.
EXPO_PUBLIC_SUPABASE_URL=https://jzoswcsprsysbdpgnqsk.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Set to 1 to use the in-memory sample data instead of Supabase (no credentials needed).
EXPO_PUBLIC_USE_MOCK=0
# CARTO basemaps key for the map tiles (free tiers at carto.com/basemaps/apikey). Without it the
# tiles show an "API key required" watermark.
EXPO_PUBLIC_CARTO_BASEMAPS_KEY=
